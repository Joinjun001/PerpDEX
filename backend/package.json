{
  "name": "perpdex-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "test:postgres-local": "node --experimental-strip-types --test qa/postgres-local.test.ts",
    "test:postgres-perp": "node --experimental-strip-types --test qa/postgres-perp-sim.test.ts",
    "test:postgres-paired": "node --experimental-strip-types --test qa/postgres-paired-clearing.test.ts",
    "build": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "start": "node --experimental-strip-types src/http/server.ts"
  },
  "dependencies": {
    "pg": "8.16.3",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
