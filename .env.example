# Sepolia RPC endpoint. 실제 프로젝트 키/토큰은 .env에만 저장한다.
SEPOLIA_RPC_URL=https://sepolia.example-rpc.invalid/v3/YOUR_PROJECT_ID

# 배포 계정의 private key 예시 형식. 실제 키를 저장소에 커밋하지 않는다.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# CollateralVault 생성자에 전달할 초기 settlement executor 주소.
SETTLEMENT_EXECUTOR=0x1111111111111111111111111111111111111111
